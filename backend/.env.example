# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@localhost:5432/studymate
DATABASE_URL=
# Long random string (e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
# FastAPI ML service (placeholder in the 25% build)
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=1500
# Only used by `npm run seed` (demo data); choose any password for the demo account
SEED_DEMO_PASSWORD=
# Only used by integration tests: use a SEPARATE database (tables are truncated)
TEST_DATABASE_URL=
